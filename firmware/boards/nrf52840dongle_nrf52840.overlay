/*
 * Voice Keyboard — nRF52840 dongle additions.
 * The board DTS already enables zephyr_udc0; we only need the HID device node.
 */

/ {
	hid_dev_0: hid_dev_0 {
		compatible = "zephyr,hid-device";
		interface-name = "HID0";
		/* Composite keyboard (report ID 1) + mouse (report ID 2): the
		 * report descriptor uses report IDs, which is incompatible
		 * with the HID boot protocol, so no boot protocol is claimed.
		 */
		protocol-code = "none";
		/* Longest input report: keyboard = 1 ID byte + 8 report bytes.
		 * MPS must be a power of two (16) — 9-byte keyboard reports ride
		 * as short packets on the 16-byte endpoint, normal for
		 * interrupt IN. A non-power-of-2 MPS (9) is a suspected
		 * host-side drop trigger.
		 */
		in-report-size = <16>;
		in-polling-period-us = <1000>;
	};
};

/* v5: the stock 16 KB storage partition (4 NVS sectors) cannot hold the
 * 16 KB macro store alongside the bonds (NVS needs a free
 * sector for GC). Move storage into the tail of the unused slot1 (image-1)
 * partition and enlarge it to 32 KB (8 sectors). The app is capped below
 * 0xB4000 via CONFIG_FLASH_LOAD_SIZE. Side effect: bonds stored by
 * firmware <= v4 live in the old partition and are not migrated — re-pair
 * once after flashing v5.
 */
&flash0 {
	partitions {
		/delete-node/ partition@dc000;
		storage_partition: partition@b4000 {
			label = "storage";
			reg = <0x000b4000 0x00008000>;
		};
	};
};

&slot1_partition {
	reg = <0x00076000 0x0003e000>;
};
